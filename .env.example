# Local Postgres
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/groundfit

# Neon (production)
DATABASE_URL_PRODUCTION=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-….neon.tech/neondb?sslmode=require

# Ports — frontend 2000, backend 7000
PORT=7000
FRONTEND_URL=http://localhost:2000
CORS_ORIGINS=http://localhost:2000
VITE_API_URL=http://localhost:7000

# Google OAuth (from Google Cloud Console → Credentials)
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET

JWT_SECRET=change-me-to-a-long-random-string

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Email — Render free: EMAIL_PROVIDER=gmail (see docs/GMAIL_API_EMAIL.md)
EMAIL_ENABLED=true
EMAIL_PROVIDER=gmail
GMAIL_SENDER=groundfit.in@gmail.com
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
RESEND_API_KEY=
RESEND_FROM=GroundFit <onboarding@resend.dev>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GroundFit <groundfit.in@gmail.com>
SMTP_TLS=true
SMTP_SSL=false

# Job expiry reminders (Lists page)
REMINDER_HOURS_BEFORE=12
REMINDER_POLL_SECONDS=60
CRON_SECRET=change-me-long-random-cron-secret

# Render keep-alive (free tier: sleep after ~15 min idle → use scheduler every 10 min)
KEEPALIVE_ENABLED=false
KEEPALIVE_INTERVAL_SECONDS=600
PUBLIC_API_URL=https://groundfit.onrender.com
