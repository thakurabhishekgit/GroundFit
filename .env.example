# Local Postgres
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/groundfit

# Neon (production)
DATABASE_URL_PRODUCTION=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-….neon.tech/neondb?sslmode=require

# Ports — frontend 2000, backend 7000
PORT=7000
FRONTEND_URL=http://localhost:2000
CORS_ORIGINS=http://localhost:2000
VITE_API_URL=http://localhost:7000

# Google OAuth (from Google Cloud Console → Credentials)
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET

JWT_SECRET=change-me-to-a-long-random-string

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Email (SMTP) — set EMAIL_ENABLED=true after filling SMTP_*
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GroundFit <noreply@yourdomain.com>
SMTP_TLS=true
SMTP_SSL=false

# Job expiry reminders (Lists page)
REMINDER_HOURS_BEFORE=12
REMINDER_POLL_SECONDS=300
CRON_SECRET=change-me-long-random-cron-secret
